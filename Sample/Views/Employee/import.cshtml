@model Sample.Models.ImportViewModel

<h2>Import Employees</h2>

<form asp-action="Import"
      asp-controller="Employee"
      method="post"
      enctype="multipart/form-data">

    <div class="mb-3">

        <label class="form-label">
            Select Excel File
        </label>

        <input type="file"
               name="ExcelFile"
               class="form-control"
               accept=".xlsx" />

    </div>

    <button type="submit" class="btn btn-primary">
        Import Employees
    </button>

</form>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info mt-3">
        @ViewBag.Message
    </div>
}
