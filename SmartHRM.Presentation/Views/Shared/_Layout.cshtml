<!DOCTYPE html>

<html lang="en">

<head>
<meta charset="utf-8" />

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<title>
    @ViewData["Title"] - Smart HRM
</title>


<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

<!-- Bootstrap Icons -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<!-- Font Awesome -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
 <link rel="icon" type="image/png" href="~/videos/icon.png" />

<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    body {
        background-color: #0b0f19;

        background-image:
            radial-gradient(
                at 0% 0%,
                rgba(37, 99, 235, 0.12) 0px,
                transparent 50%
            ),
            radial-gradient(
                at 100% 100%,
                rgba(59, 130, 246, 0.08) 0px,
                transparent 50%
            );

        background-attachment: fixed;

        color: #f1f5f9;

        overflow-x: hidden;

        min-height: 100vh;
    }



    .sidebar {

        width: 260px;

        background: rgba(15, 23, 42, 0.75);

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        min-height: 100vh;

        border-right:
            1px solid rgba(255, 255, 255, 0.08);

        display: flex;

        flex-direction: column;

        position: fixed;

        top: 0;
        bottom: 0;
        left: 0;

        z-index: 1040;
    }


   

    .sidebar-brand {

        padding: 24px 20px;

        display: flex;

        align-items: center;

        gap: 12px;

        border-bottom:
            1px solid rgba(255, 255, 255, 0.06);
    }


    .brand-icon {

        width: 40px;
        height: 40px;

        background:
            linear-gradient(
                135deg,
                #3b82f6 0%,
                #1d4ed8 100%
            );

        color: #ffffff;

        border-radius: 12px;

        display: flex;

        align-items: center;
        justify-content: center;

        font-size: 1.25rem;

        box-shadow:
            0 8px 16px -4px
            rgba(37, 99, 235, 0.5);
    }


  

    .nav-link-custom {

        display: flex;

        align-items: center;

        gap: 14px;

        padding: 13px 22px;

        color: #94a3b8;

        font-weight: 500;

        font-size: 0.92rem;

        text-decoration: none;

        transition: all 0.2s ease;

        position: relative;
    }


    .nav-link-custom i {

        font-size: 1.15rem;

        color: #64748b;

        transition: color 0.2s ease;
    }


    .nav-link-custom:hover {

        color: #ffffff;

        background:
            rgba(255, 255, 255, 0.04);
    }


    .nav-link-custom:hover i {

        color: #60a5fa;
    }


    .nav-link-custom.active {

        color: #60a5fa;

        background:
            rgba(59, 130, 246, 0.12);

        font-weight: 600;
    }


    .nav-link-custom.active i {

        color: #60a5fa;
    }


    .nav-link-custom.active::after {

        content: '';

        position: absolute;

        right: 0;

        top: 0;
        bottom: 0;

        width: 3px;

        background: #3b82f6;

        box-shadow:
            0 0 10px #3b82f6;

        border-radius:
            4px 0 0 4px;
    }


  

    .main-wrapper {

        margin-left: 260px;

        min-height: 100vh;

        display: flex;

        flex-direction: column;

        transition:
            margin-left 0.3s ease;
    }




    .top-navbar {

        background:
            rgba(15, 23, 42, 0.65);

        backdrop-filter: blur(16px);

        -webkit-backdrop-filter: blur(16px);

        border-bottom:
            1px solid rgba(255, 255, 255, 0.08);

        padding: 14px 28px;

        display: flex;

        align-items: center;

        justify-content: space-between;

        position: sticky;

        top: 0;

        z-index: 1030;
    }

    #img-logo{
        height:30px;
        width:120px;
    }
   

    .app-footer {

        background:
            rgba(15, 23, 42, 0.95);

        border-top:
            1px solid rgba(255, 255, 255, 0.08);

        color: #94a3b8;

        margin-top: auto;
    }


    .footer-link {

        color: #94a3b8;

        text-decoration: none;

        display: inline-flex;

        align-items: center;

        gap: 8px;

        transition:
            color 0.2s ease,
            transform 0.2s ease;
    }


    .footer-link:hover {

        color: #60a5fa;

        transform:
            translateX(3px);
    }


    .footer-logo {

        max-height: 30px;

        width: auto;

        border-radius: 8px;
    }


   

    @@media (max-width: 991.98px) {

        .sidebar {

            transform:
                translateX(-100%);

            transition:
                transform 0.3s ease;
        }


        .sidebar.show {

            transform:
                translateX(0);
        }


        .main-wrapper {

            margin-left: 0 !important;
        }


        .sidebar-backdrop {

            position: fixed;

            inset: 0;

            background:
                rgba(0, 0, 0, 0.65);

            backdrop-filter:
                blur(4px);

            z-index: 1035;

            display: none;
        }


        .sidebar-backdrop.show {

            display: block;
        }


        .top-navbar {

            padding:
                12px 18px;
        }


        main {

            padding:
                1rem !important;
        }


        .footer-logo-wrapper {

            text-align: center;

            margin-bottom: 15px;
        }
    }

</style>

</head>

<body>




<div class="sidebar-backdrop"
     id="sidebarBackdrop"
     onclick="toggleSidebar()">
</div>




<aside class="sidebar"
       id="appSidebar">


   

    <div class="sidebar-brand">

        <div class="brand-icon">

            <i class="bi bi-shield-check"></i>

        </div>


        <div>

            <div class="fw-bold fs-5 text-white lh-1">
                LOGIX HRM
            </div>

            <small class="text-secondary"
                   style="font-size: 0.72rem;
                          letter-spacing: 0.5px;">
                Reports
            </small>

        </div>

    </div>


    

    <nav class="nav flex-column mt-3 gap-1">


       

        <a class="nav-link-custom
            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard"
                ? "active"
                : "")"

           asp-controller="Dashboard"
           asp-action="Index">

            <i class="bi bi-grid-fill"></i>

            <span>
                Dashboard
            </span>

        </a>


     

        <a class="nav-link-custom
            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee"
                || ViewContext.RouteData.Values["controller"]?.ToString() == "Employees"
                ? "active"
                : "")"

           asp-controller="Employee"
           asp-action="Index">

            <i class="bi bi-people-fill"></i>

            <span>
                Employees
            </span>

        </a>


       

        <a class="nav-link-custom
            @(ViewContext.RouteData.Values["controller"]?.ToString() == "LiveAttendance"
                ? "active"
                : "")"

           asp-controller="LiveAttendance"
           asp-action="Index">

            <i class="bi bi-camera-video-fill"></i>

            <span>
                Live Attendance
            </span>

        </a>


     

        <a class="nav-link-custom
            @(ViewContext.RouteData.Values["controller"]?.ToString() == "Attendance"
                ? "active"
                : "")"

           asp-controller="Attendance"
           asp-action="Reports">

            <i class="bi bi-calendar-check-fill"></i>

            <span>
                Attendance Logs
            </span>

        </a>


      

        <a class="nav-link-custom
            @(ViewContext.RouteData.Values["controller"]?.ToString() == "About"
                ? "active"
                : "")"

           asp-controller="About"
           asp-action="about">

            <i class="bi bi-info-circle-fill"></i>

            <span>
                About
            </span>

        </a>

    </nav>


   

    <div class="mt-auto p-3 border-top border-secondary border-opacity-25">

        <form asp-controller="Account"
              asp-action="Logout"
              method="post">

            @Html.AntiForgeryToken()


            <button type="submit"
                    class="btn btn-outline-danger w-100
                           d-flex align-items-center
                           justify-content-center
                           gap-2 rounded-3 py-2"

                    style="
                        background:
                        rgba(239, 68, 68, 0.08);

                        border-color:
                        rgba(239, 68, 68, 0.3);
                    ">

                <i class="bi bi-box-arrow-right"></i>

                <span>
                    Logout
                </span>

            </button>

        </form>

    </div>

</aside>




<div class="main-wrapper">


   

    <header class="top-navbar">


        <button class="btn btn-sm text-light
                       d-lg-none p-1"

                onclick="toggleSidebar()"

                aria-label="Toggle Navigation">

            <i class="bi bi-list fs-4"></i> 

        </button>

            <img src="~/videos/Gemini_Generated_Image_p7wevhp7wevhp7we-removebg-preview.png" alt=""  id="img-logo"/>
        <div class="d-flex align-items-center
                    gap-2 ms-auto">

            <div class="rounded-circle
                        bg-primary
                        bg-opacity-25
                        text-info
                        d-flex
                        align-items-center
                        justify-content-center
                        fw-bold"

                 style="
                     width: 34px;
                     height: 34px;
                     font-size: 0.85rem;
                 ">

                @{
                    var userName =
                        User.Identity?.Name ?? "Administrator";

                    var firstLetter =
                        !string.IsNullOrEmpty(userName)
                            ? userName.Substring(0, 1).ToUpper()
                            : "A";
                }

                @firstLetter

            </div>


            <span class="text-muted small">

                Signed in as

                <strong class="text-white">
                    @(User.Identity?.Name ?? "Administrator")
                </strong>

            </span>

        </div>

    </header>



    <main class="flex-grow-1 p-4">

        @RenderBody()

    </main>


    

    <footer class="app-footer py-4 px-4">


        <div class="container-fluid">


            <div class="row g-4 text-start">


               

                <div class="col-lg-4 col-md-6">

                    <div class="footer-logo-wrapper">

                        <img src="~/videos/Gemini_Generated_Image_p7wevhp7wevhp7we-removebg-preview.png"
                             alt="Smart HRM Logo"
                             class="footer-logo" id="img-logo" />

                    </div>


                    <h5 class="text-white fw-bold mb-2">

                        Smart
                        <span class="text-primary">
                            HRM
                        </span>

                    </h5>


                    <p class="small text-secondary mb-0">

                        Enterprise Human Resource
                        Management &amp; automated
                        biometric attendance tracking
                        platform.

                    </p>

                </div>


                <!-- VISIT US -->

                <div class="col-lg-4 col-md-6">

                    <h6 class="text-primary fw-bold mb-2">
                        Visit Us
                    </h6>


                    <p class="small text-secondary mb-1">

                        Office No.1, A-Wing,
                        4th floor, Vishwa Arcade,
                        Bangalore – Mumbai Highway,
                        Narhe, Pune – 411041

                    </p>


                    <p class="small text-secondary mb-0">

                        <strong>
                            Phone:
                        </strong>

                        8446225511 /
                        9096588895

                        <br />

                        <strong>
                            Email:
                        </strong>

                        info@trylogix.com

                    </p>

                </div>


                

                <div class="col-lg-4 col-md-12">

                    <h6 class="text-primary fw-bold mb-2">
                        Social Contact
                    </h6>


                    <div class="d-flex flex-column gap-2">


                        <a href="https://instagram.com/trylogix"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="footer-link small">

                            <i class="fa-brands
                                      fa-instagram
                                      text-danger
                                      fs-6">
                            </i>

                            <span>
                                Instagram
                            </span>

                        </a>


                        <a href="https://x.com/trylogix_twite"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="footer-link small">

                            <i class="fa-brands
                                      fa-x-twitter
                                      text-light
                                      fs-6">
                            </i>

                            <span>
                                Twitter / X
                            </span>

                        </a>


                        <a href="https://facebook.com/trylogix"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="footer-link small">

                            <i class="fa-brands
                                      fa-facebook-f
                                      text-primary
                                      fs-6">
                            </i>

                            <span>
                                Facebook
                            </span>

                        </a>

                    </div>

                </div>

            </div>


            <hr class="border-secondary
                       opacity-25
                       my-3" />


            <div class="text-center
                        text-secondary
                        small">

                &copy; @DateTime.Now.Year Smart HRM.

            </div>

        </div>

    </footer>

</div>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
</script>




<script>

    function toggleSidebar() {

        const sidebar =
            document.getElementById("appSidebar");

        const backdrop =
            document.getElementById("sidebarBackdrop");

        sidebar.classList.toggle("show");

        backdrop.classList.toggle("show");
    }

</script>




@await RenderSectionAsync("Scripts", required: false)


</body>

</html>
