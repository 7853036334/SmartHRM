<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>About Us - Smart HRM</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  
    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: Arial, sans-serif;
            }

            body {
                background: #0b0f19;
                color: white;
                overflow-x: hidden;
            }

           

            .about-first {
                position: relative;
                width: 100%;
                min-height: 700px;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
            }


           

            .bg-video {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 0;
            }



            .video-overlay {
                position: absolute;
                inset: 0;
                background: rgba(0, 0, 0, 0.60);
                z-index: 1;
            }


           

            .about-content {
                position: relative;
                z-index: 2;
                max-width: 950px;
                padding: 40px 20px;
            }


                .about-content h3 {
                    color: #60a5fa;
                    font-size: 28px;
                    margin-bottom: 20px;
                }


                .about-content h1 {
                    font-size: 55px;
                    font-weight: bold;
                    line-height: 1.15;
                    margin-bottom: 30px;
                }


                .about-content pre {
                    font-family: Arial, sans-serif;
                    white-space: pre-wrap;
                    font-size: 17px;
                    line-height: 1.8;
                    color: #e2e8f0;
                    background: transparent;
                    border: none;
                    margin: 0;
                }


       

            .features-section {
                padding: 80px 30px;
                background: radial-gradient( circle at top, rgba(37, 99, 235, 0.15), transparent 50% ), #0b0f19;
            }


            .section-title {
                text-align: center;
                margin-bottom: 50px;
            }


                .section-title h2 {
                    font-size: 38px;
                    font-weight: bold;
                }


                .section-title p {
                    color: #94a3b8;
                    margin-top: 10px;
                }


            

            .feature-card {
                height: 100%;
                padding: 30px;
                text-align: center;
                border-radius: 18px;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                backdrop-filter: blur(10px);
                transition: all 0.3s ease;
                cursor: pointer;
            }


             

                .feature-card:hover {
                    transform: translateY(-10px) scale(1.03);
                    background: rgba(255, 255, 255, 0.14);
                    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
                }


         

            .feature-icon {
                width: 70px;
                height: 70px;
                margin: 0 auto 20px;
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient( 135deg, #3b82f6, #1d4ed8 );
                font-size: 30px;
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.35);
            }


            .feature-card h4 {
                margin-bottom: 12px;
                font-weight: bold;
            }


            .feature-card p {
                color: #94a3b8;
                line-height: 1.6;
                margin: 0;
            }


           

            .dashboard-section {
                padding: 80px 30px;
                background: #0f172a;
            }


            .dashboard-card {
                height: 100%;
                padding: 25px;
                border-radius: 15px;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.08);
                transition: 0.3s;
            }


                .dashboard-card:hover {
                    transform: translateY(-8px);
                    border-color: rgba(59, 130, 246, 0.5);
                }


                .dashboard-card i {
                    font-size: 30px;
                    color: #60a5fa;
                    margin-bottom: 15px;
                }


                .dashboard-card h5 {
                    font-weight: bold;
                }


                .dashboard-card p {
                    color: #94a3b8;
                    margin-bottom: 0;
                }


          

            footer {
                padding: 0%;
                text-align: center;
                background: #020617;
                color: white;
            }


                footer span {
                    color: #60a5fa;
                }

            .image {
                float: left;
            }

            .info {
                float: inline-start;
            }



            @@media (max-width: 768px) {

                .navbar-custom {
                    padding: 15px 20px;
                }

                .about-first {
                    min-height: 650px;
                }

                .about-content h1 {
                    font-size: 38px;
                }

                .about-content h3 {
                    font-size: 22px;
                }

                .about-content pre {
                    font-size: 14px;
                }

                .nav-link {
                    margin-left: 0;
                }
            }

    </style>
</head>

<body>
    <section class="about-first">


        <!-- Background Video -->

        <video autoplay
               muted
               loop
               playsinline
               class="bg-video">

            <source src="~/videos/wmremove-transformed.mp4"
                    type="video/mp4">

        </video>


        <!-- Dark Overlay -->

        <div class="video-overlay"></div>


        <!-- Content -->

        <div class="about-content">

            <h3>
                About Us
            </h3>


            <h1>
                Your Work Life
                <br>
                All in One Place
            </h1>


            <pre>
Smart HRM is a comprehensive Human Resource Management System
designed to streamline and optimize HR processes for businesses
of all sizes.

Our platform offers a wide range of features, including employee
management, attendance tracking, payroll processing, performance
evaluation, and more.

With Smart HRM, organizations can enhance productivity, improve
employee engagement, simplify HR operations, and make data-driven
decisions to drive growth and success.
            </pre>

        </div>

    </section>



   

    <section class="features-section">


        <div class="section-title">

            <h2>
                Smart HRM Features
            </h2>

            <p>
                Everything you need to manage your workforce efficiently.
            </p>

        </div>


        <div class="container">

            <div class="row g-4">



                <div class="col-lg-3 col-md-6">

                    <div class="feature-card">

                        <div class="feature-icon">

                            <i class="bi bi-calendar-check"></i>

                        </div>

                        <h4>
                            Attendance
                        </h4>

                        <p>
                            Track employee attendance and
                            maintain accurate attendance records.
                        </p>

                    </div>

                </div>




                <div class="col-lg-3 col-md-6">

                    <div class="feature-card">

                        <div class="feature-icon">

                            <i class="bi bi-people"></i>

                        </div>

                        <h4>
                            Employee
                        </h4>

                        <p>
                            Manage employee information,
                            departments, roles, and profiles.
                        </p>

                    </div>

                </div>




                <div class="col-lg-3 col-md-6">

                    <div class="feature-card">

                        <div class="feature-icon">

                            <i class="bi bi-camera-video"></i>

                        </div>

                        <h4>
                            Live Attendance
                        </h4>

                        <p>
                            Monitor live attendance using
                            real-time attendance tracking.
                        </p>

                    </div>

                </div>



               

                <div class="col-lg-3 col-md-6">

                    <div class="feature-card">

                        <div class="feature-icon">

                            <i class="bi bi-person-x"></i>

                        </div>

                        <h4>
                            Absent
                        </h4>

                        <p>
                            Easily identify absent employees
                            and monitor attendance status.
                        </p>

                    </div>

                </div>


            </div>

        </div>

    </section>



 

    <section class="dashboard-section">


        <div class="section-title">

            <h2>
                Manage HR Easily
            </h2>

            <p>
                Smart HRM brings important HR operations together
                in one centralized platform.
            </p>

        </div>


        <div class="container">

            <div class="row g-4">


                <div class="col-md-4">

                    <div class="dashboard-card">

                        <i class="bi bi-person-badge"></i>

                        <h5>
                            Employee Management
                        </h5>

                        <p>
                            Maintain employee profiles and
                            organize employee information efficiently.
                        </p>

                    </div>

                </div>



                <div class="col-md-4">

                    <div class="dashboard-card">

                        <i class="bi bi-clock-history"></i>

                        <h5>
                            Attendance Tracking
                        </h5>

                        <p>
                            Track employee attendance and
                            monitor daily attendance activity.
                        </p>

                    </div>

                </div>



                <div class="col-md-4">

                    <div class="dashboard-card">

                        <i class="bi bi-cash-stack"></i>

                        <h5>
                            Payroll Processing
                        </h5>

                        <p>
                            Organize payroll information and
                            simplify payroll-related processes.
                        </p>

                    </div>

                </div>



                <div class="col-md-4">

                    <div class="dashboard-card">

                        <i class="bi bi-graph-up"></i>

                        <h5>
                            Performance
                        </h5>

                        <p>
                            Manage employee performance information
                            and support performance evaluation.
                        </p>

                    </div>

                </div>



                <div class="col-md-4">

                    <div class="dashboard-card">

                        <i class="bi bi-file-earmark-text"></i>

                        <h5>
                            HR Reports
                        </h5>

                        <p>
                            Access HR information and use reports
                            to support data-driven decisions.
                        </p>

                    </div>

                </div>



                <div class="col-md-4">

                    <div class="dashboard-card">

                        <i class="bi bi-shield-check"></i>

                        <h5>
                            Secure HR System
                        </h5>

                        <p>
                            Keep HR operations organized through
                            a centralized management system.
                        </p>

                    </div>

                </div>


            </div>

        </div>

    </section>
   

    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
    </script>


</body>
</html>

