@model IEnumerable<SmartHRM.DataAccess.Entities.AttendanceLog>
@{
    ViewData["Title"] = "Live Attendance";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Glassmorphism Containers */
    .glass-panel {
        background: rgba(15, 23, 42, 0.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        box-shadow: 0 20px 45px -12px rgba(0, 0, 0, 0.55);
    }

    /* Video Player Card */
    .video-feed-card {
        position: relative;
        background: #030712;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.7);
        aspect-ratio: 16 / 10;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .video-stream-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Stream Overlays */
    .cam-tag-overlay {
        position: absolute;
        top: 16px;
        left: 16px;
        background: rgba(15, 23, 42, 0.85);
        backdrop-filter: blur(8px);
        color: #f8fafc;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        z-index: 10;
    }

    .live-pill-overlay {
        position: absolute;
        top: 16px;
        right: 16px;
        background: rgba(239, 68, 68, 0.9);
        backdrop-filter: blur(8px);
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        padding: 4px 12px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        gap: 6px;
        z-index: 10;
        box-shadow: 0 0 14px rgba(239, 68, 68, 0.5);
    }

    .live-dot-pulse {
        width: 7px;
        height: 7px;
        background: #fff;
        border-radius: 50%;
        animation: pulseDot 1.5s infinite;
    }

@@keyframes pulseDot {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.3;
            transform: scale(0.85);
        }
    }

    /* Bottom Verification Bar */
    .recognition-banner-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(11, 15, 25, 0.9);
        backdrop-filter: blur(14px);
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        z-index: 10;
    }

    .emp-name-text {
        color: #4ade80;
        font-weight: 700;
        font-size: 1.15rem;
        line-height: 1.2;
    }

    .emp-id-text {
        color: #94a3b8;
        font-size: 0.85rem;
        font-weight: 500;
    }

    .meta-label {
        font-size: 0.72rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .meta-val {
        font-size: 0.95rem;
        font-weight: 600;
        color: #f8fafc;
    }

    .badge-present-pill {
        background: rgba(34, 197, 94, 0.16);
        color: #4ade80;
        font-weight: 600;
        font-size: 0.78rem;
        padding: 4px 10px;
        border-radius: 12px;
        border: 1px solid rgba(34, 197, 94, 0.35);
        display: inline-block;
    }

    .check-icon-circle {
        font-size: 2.2rem;
        color: #22c55e;
        line-height: 1;
    }

    /* Right Sidebar Feed */
    .recognitions-list {
        flex: 1;
        overflow-y: auto;
        max-height: 480px;
        padding-right: 4px;
    }

    .recognition-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 10px;
        border-radius: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        transition: background-color 0.15s ease;
    }

    .recognition-item:hover {
        background: rgba(255, 255, 255, 0.04);
    }

    .emp-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .avatar-fallback {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(59, 130, 246, 0.18);
        border: 1px solid rgba(59, 130, 246, 0.35);
        color: #60a5fa;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }

    .view-all-link {
        color: #60a5fa;
        font-size: 0.88rem;
        font-weight: 600;
        text-decoration: none;
        display: block;
        text-align: center;
        margin-top: 14px;
        transition: color 0.2s ease;
    }

    .view-all-link:hover {
        color: #93c5fd;
        text-decoration: underline;
    }

    /* Responsive Adjustments */
    @@media (max-width: 767.98px) {
        .page-wrapper {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .recognition-banner-overlay {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 16px;
        }

        .recognition-banner-overlay > div:last-child {
            display: none;
        }

        .video-feed-card {
            aspect-ratio: 4 / 3;
        }
    }
</style>

<div class="container-fluid py-4 px-3 px-md-4 page-wrapper">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-white mb-1">Live Attendance Gate</h4>
            <div class="small text-muted">Attendance &gt; <span class="text-light fw-medium">Real-Time Biometric Verification</span></div>
        </div>
        <span id="signalrStatusBadge" class="badge rounded-pill px-3 py-2" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); color: #94a3b8;">
            Connecting...
        </span>
    </div>

    <!-- Quick Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-md-3">
            <div class="glass-panel p-3">
                <div class="text-muted small fw-medium">Present Today</div>
                <div class="fs-4 fw-bold text-success mt-1" id="presentTodayCount">0</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <div class="glass-panel p-3">
                <div class="text-muted small fw-medium">Absent Today</div>
                <div class="fs-4 fw-bold text-danger mt-1" id="absentTodayCount">0</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT: Live Stream & Verification Bar -->
        <div class="col-12 col-xl-8 col-lg-7">
            <div class="video-feed-card">
                <div class="cam-tag-overlay">
                    <i class="bi bi-camera me-1"></i> Camera 01 - Main Gate
                </div>
                <div class="live-pill-overlay">
                    <span class="live-dot-pulse"></span> LIVE
                </div>

                <!-- Live Python MJPEG Stream -->
                <img id="aiVideoFeed"
                     src="http://127.0.0.1:8000/video_feed"
                     class="video-stream-img"
                     alt="Live Camera Stream"
                     onerror="this.src='/images/camera-offline-placeholder.png';" />

                <!-- Bottom Floating Verification Bar -->
                <div id="activeDetectionBar" class="recognition-banner-overlay">
                    <div>
                        <div class="emp-name-text" id="activeName">Waiting for face...</div>
                        <div class="emp-id-text" id="activeCode">--</div>
                    </div>

                    <div class="d-flex align-items-center gap-4">
                        <div>
                            <div class="meta-label">Time</div>
                            <div class="meta-val" id="activeTime">--:--:--</div>
                        </div>
                        <div>
                            <div class="meta-label">Status</div>
                            <div>
                                <span class="badge-present-pill" id="activeStatus">Idle</span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <i class="bi bi-check-circle-fill check-icon-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: Recent Recognitions Feed -->
        <div class="col-12 col-xl-4 col-lg-5">
            <div class="glass-panel p-3 p-md-4 h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <h6 class="fw-bold text-white mb-0">Recent Recognitions</h6>
                    <span class="badge rounded-pill px-2 py-1" style="background: rgba(34, 197, 94, 0.16); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.35); font-size: 0.72rem;">STREAM</span>
                </div>

                <div class="recognitions-list" id="recentListContainer">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <div class="recognition-item">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(log.Employee?.PhotoPath))
                                    {
                                        <img src="@log.Employee.PhotoPath" class="emp-avatar" alt="Photo" onerror="this.outerHTML='<div class=\'avatar-fallback\'>@((log.Employee?.FullName ?? "E").Substring(0, 1).ToUpper())</div>';" />
                                    }
                                    else
                                    {
                                        <div class="avatar-fallback">@((log.Employee?.FullName ?? "E").Substring(0, 1).ToUpper())</div>
                                    }
                                    <div>
                                        <div class="fw-semibold text-white" style="font-size: 0.92rem;">@log.Employee?.FullName</div>
                                        <div class="text-muted" style="font-size: 0.78rem;">@log.Employee?.EmployeeCode</div>
                                    </div>
                                </div>

                                <div class="text-end">
                                    <div class="text-light small" style="font-size: 0.78rem; font-weight: 500;">
                                        @(log.TimeIn.HasValue ? DateTime.Today.Add(log.TimeIn.Value).ToString("hh:mm:ss tt") : "--:--:--")
                                    </div>
                                    <div class="mt-1">
                                        <span class="badge-present-pill" style="font-size: 0.72rem; padding: 2px 8px;">
                                            @log.Status
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div id="noLogsPlaceholder" class="text-center py-5 text-muted small">
                            <i class="bi bi-person-check fs-2 d-block mb-2 text-secondary"></i>
                            Waiting for live camera check-ins...
                        </div>
                    }
                </div>

                <a asp-controller="Attendance" asp-action="Reports" class="view-all-link">View Full Report</a>
            </div>
        </div>
    </div>
</div>

<!-- SignalR Client -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/attendanceHub")
        .withAutomaticReconnect()
        .build();

    const signalrBadge = document.getElementById("signalrStatusBadge");

    connection.on("ReceiveAttendanceUpdate", function(data) {
        const placeholder = document.getElementById("noLogsPlaceholder");
        if (placeholder) placeholder.remove();

        const activeName = document.getElementById("activeName");
        const activeCode = document.getElementById("activeCode");
        const activeTime = document.getElementById("activeTime");
        const activeStatus = document.getElementById("activeStatus");

        if (activeName) activeName.innerText = data.fullName;
        if (activeCode) activeCode.innerText = data.employeeId;
        if (activeTime) activeTime.innerText = data.time;
        if (activeStatus) activeStatus.innerText = data.status;

        const presentElem = document.getElementById("presentTodayCount");
        const absentElem = document.getElementById("absentTodayCount");
        if (presentElem && data.presentCount !== undefined) presentElem.innerText = data.presentCount;
        if (absentElem && data.absentCount !== undefined) absentElem.innerText = data.absentCount;

        const listContainer = document.getElementById("recentListContainer");
        if (listContainer) {
            const initials = data.fullName ? data.fullName.charAt(0).toUpperCase() : "E";
            const avatarHtml = data.photoPath
                ? `<img src="${data.photoPath}" class="emp-avatar" alt="Photo" onerror="this.outerHTML='<div class=\\'avatar-fallback\\'>${initials}</div>';" />`
                : `<div class="avatar-fallback">${initials}</div>`;

            const newItem = document.createElement("div");
            newItem.className = "recognition-item";
            newItem.innerHTML = `
                <div class="d-flex align-items-center gap-3">
                    ${avatarHtml}
                    <div>
                        <div class="fw-semibold text-white" style="font-size: 0.92rem;">${data.fullName}</div>
                        <div class="text-muted" style="font-size: 0.78rem;">${data.employeeId}</div>
                    </div>
                </div>
                <div class="text-end">
                    <div class="text-light small" style="font-size: 0.78rem; font-weight: 500;">${data.time}</div>
                    <div class="mt-1">
                        <span class="badge-present-pill" style="font-size: 0.72rem; padding: 2px 8px;">${data.status}</span>
                    </div>
                </div>
            `;
            listContainer.insertBefore(newItem, listContainer.firstChild);
        }
    });

    connection.start()
        .then(() => {
            if (signalrBadge) {
                signalrBadge.style.background = "rgba(34, 197, 94, 0.16)";
                signalrBadge.style.color = "#4ade80";
                signalrBadge.style.borderColor = "rgba(34, 197, 94, 0.35)";
                signalrBadge.innerText = "SignalR Online";
            }
        })
        .catch(err => {
            console.error("SignalR connection error:", err);
            if (signalrBadge) {
                signalrBadge.style.background = "rgba(239, 68, 68, 0.16)";
                signalrBadge.style.color = "#f87171";
                signalrBadge.style.borderColor = "rgba(239, 68, 68, 0.35)";
                signalrBadge.innerText = "Offline";
            }
        });
</script>