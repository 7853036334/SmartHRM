@model SmartHRM.DataAccess.Entities.LoginViewModel
@{
    ViewData["Title"] = "Login - Smart HRM";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Inter', system-ui, -apple-system, sans-serif;
            }

            body {
                position: relative;
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
                overflow: hidden;
                background-color: #030712;
            }

            /* Fullscreen Video */
            .video-bg {
                position: fixed;
                top: 50%;
                left: 50%;
                min-width: 100%;
                min-height: 100%;
                width: auto;
                height: auto;
                transform: translate(-50%, -50%);
                object-fit: cover;
                z-index: -2;
            }

            /* Subtle Dark Tint with Blur */
            .video-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(circle at center, rgba(15, 23, 42, 0.55) 0%, rgba(3, 7, 18, 0.85) 100%);
                backdrop-filter: blur(8px);
                z-index: -1;
            }

            /* Centered Glassmorphism Card */
            .login-card {
                width: 100%;
                max-width: 440px;
                background: rgba(255, 255, 255, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.15);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
                border-radius: 28px;
                padding: 44px 38px;
                box-shadow: 0 25px 60px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.2);
                position: relative;
                z-index: 1;
                color: #ffffff;
            }

            .brand-header {
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
                margin-bottom: 30px;
            }

            .brand-icon {
                width: 58px;
                height: 58px;
                background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
                border-radius: 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.8rem;
                color: #ffffff;
                margin-bottom: 14px;
                box-shadow: 0 10px 25px rgba(37, 99, 235, 0.4);
            }

            .brand-title {
                font-size: 1.55rem;
                font-weight: 800;
                letter-spacing: -0.5px;
                color: #ffffff;
            }

            .brand-subtitle {
                font-size: 0.85rem;
                color: #94a3b8;
                margin-top: 4px;
            }

            .form-label {
                font-size: 0.85rem;
                font-weight: 600;
                color: #e2e8f0;
                margin-bottom: 7px;
            }

            .input-group-custom {
                position: relative;
                margin-bottom: 18px;
            }

            .input-group-custom input {
                width: 100%;
                padding: 13px 16px 13px 44px;
                background: rgba(255, 255, 255, 0.07);
                border: 1px solid rgba(255, 255, 255, 0.15);
                border-radius: 12px;
                font-size: 0.95rem;
                color: #ffffff;
                outline: none;
                transition: all 0.25s ease;
            }

            .input-group-custom input::placeholder {
                color: #64748b;
            }

            .input-group-custom input:focus {
                background: rgba(255, 255, 255, 0.12);
                border-color: #60a5fa;
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.25);
            }

            .input-icon-left {
                position: absolute;
                top: 50%;
                left: 15px;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 1.15rem;
                pointer-events: none;
            }

            .password-toggle {
                position: absolute;
                top: 50%;
                right: 15px;
                transform: translateY(-50%);
                color: #94a3b8;
                cursor: pointer;
                font-size: 1.15rem;
                transition: color 0.2s;
            }

            .password-toggle:hover {
                color: #ffffff;
            }

            .form-options {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-top: 4px;
                margin-bottom: 24px;
                font-size: 0.85rem;
            }

            .form-check-input {
                background-color: rgba(255, 255, 255, 0.1);
                border-color: rgba(255, 255, 255, 0.25);
                cursor: pointer;
            }

            .form-check-input:checked {
                background-color: #3b82f6;
                border-color: #3b82f6;
            }

            .form-check-label {
                color: #cbd5e1;
                cursor: pointer;
            }

            .forgot-link {
                color: #60a5fa;
                text-decoration: none;
                font-weight: 500;
            }

            .forgot-link:hover {
                color: #93c5fd;
                text-decoration: underline;
            }

            .btn-login {
                background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
                color: #ffffff;
                border: none;
                border-radius: 12px;
                padding: 13px;
                font-weight: 600;
                font-size: 1rem;
                width: 100%;
                transition: all 0.25s ease;
                box-shadow: 0 10px 20px -5px rgba(37, 99, 235, 0.5);
            }

            .btn-login:hover {
                background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
                box-shadow: 0 14px 24px -5px rgba(37, 99, 235, 0.7);
                transform: translateY(-1px);
            }

            .card-footer-text {
                font-size: 0.78rem;
                color: #64748b;
                text-align: center;
                margin-top: 24px;
            }
    </style>
</head>
<body>

    <!-- Background Video -->
    <video class="video-bg" autoplay muted loop playsinline>
        <source src="~/videos/face-attendance-bg.mp4" type="video/mp4" />
    </video>

    <!-- Dark Overlay Filter -->
    <div class="video-overlay"></div>

    <!-- Centered Glass Login Card -->
    <div class="login-card">
        <div class="brand-header">
            <div class="brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1 class="brand-title">LOGIX HRM</h1>
            <p class="brand-subtitle">Employee Authentication System</p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3 bg-danger bg-opacity-25 border-danger border-opacity-50 text-white" style="font-size: 0.85rem; border-radius: 10px;">
                    <span asp-validation-summary="All"></span>
                </div>
            }

            <div class="mb-3">
                <label class="form-label" asp-for="Email">Email Address</label>
                <div class="input-group-custom">
                    <i class="bi bi-envelope-fill input-icon-left"></i>
                    <input asp-for="Email" type="email" placeholder="email" required autofocus />
                </div>
            </div>

            <div class="mb-2">
                <label class="form-label" asp-for="Password">Password</label>
                <div class="input-group-custom">
                    <i class="bi bi-key-fill input-icon-left"></i>
                    <input asp-for="Password" id="passwordInput" type="password" placeholder="••••••••••••" required />
                    <i class="bi bi-eye password-toggle" id="togglePassword"></i>
                </div>
            </div>

            <div class="form-options">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                    <label class="form-check-label" for="rememberMe">
                        Remember me
                    </label>
                </div>
                <a asp-action="ForgotPassword" class="forgot-link">Forgot Password?</a>
            </div>

            <button type="submit" class="btn-login">Sign In</button>
        </form>
    </div>

    <script>
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('passwordInput');

            togglePassword.addEventListener('click', function () {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                this.classList.toggle('bi-eye');
                this.classList.toggle('bi-eye-slash');
            });
    </script>

</body>
</html>