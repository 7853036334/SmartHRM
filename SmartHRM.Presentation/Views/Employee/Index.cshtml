@model IEnumerable<SmartHRM.DataAccess.Entities.Employee>
@{
    ViewData["Title"] = "Employees";
}

<style>
    /* Glassmorphism Containers */
    .glass-panel {
        background: rgba(15, 23, 42, 0.72);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        box-shadow: 0 20px 45px -12px rgba(0, 0, 0, 0.55);
    }

    /* Form Controls */
    .glass-input {
        background: rgba(255, 255, 255, 0.06) !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        color: #f1f5f9 !important;
        border-radius: 10px !important;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .glass-input:focus {
        background: rgba(255, 255, 255, 0.12) !important;
        border-color: #3b82f6 !important;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25) !important;
        color: #ffffff !important;
    }

    .glass-input::placeholder {
        color: #64748b;
    }

    .glass-input option {
        background: #0f172a;
        color: #f8fafc;
    }

    /* Buttons */
    .btn-glow-primary {
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        border: none;
        color: #ffffff;
        font-weight: 600;
        border-radius: 10px;
        transition: all 0.25s ease;
        box-shadow: 0 8px 18px -4px rgba(37, 99, 235, 0.45);
        white-space: nowrap;
    }

    .btn-glow-primary:hover {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
        box-shadow: 0 12px 22px -4px rgba(37, 99, 235, 0.65);
        color: #ffffff;
        transform: translateY(-1px);
    }

    .btn-glass-secondary {
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.16);
        color: #93c5fd;
        border-radius: 10px;
        font-weight: 500;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .btn-glass-secondary:hover {
        background: rgba(255, 255, 255, 0.14);
        color: #ffffff;
        border-color: rgba(255, 255, 255, 0.3);
    }

    /* Table Styles */
    .table-glass {
        color: #cbd5e1;
        margin-bottom: 0;
    }

    .table-glass thead tr {
        background: rgba(255, 255, 255, 0.04);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .table-glass th {
        color: #94a3b8;
        font-size: 0.75rem;
        letter-spacing: 0.06em;
        font-weight: 600;
        padding-top: 16px;
        padding-bottom: 16px;
        white-space: nowrap;
    }

    .table-glass tbody tr {
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        transition: background-color 0.15s ease;
    }

    .table-glass tbody tr:hover {
        background-color: rgba(255, 255, 255, 0.04);
    }

    .table-glass td {
        padding-top: 14px;
        padding-bottom: 14px;
        vertical-align: middle;
        white-space: nowrap;
    }

    /* Badges & Avatars */
    .avatar-bubble {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: rgba(59, 130, 246, 0.18);
        border: 1px solid rgba(59, 130, 246, 0.35);
        color: #60a5fa;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .avatar-img {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        object-fit: cover;
        border: 1px solid rgba(255, 255, 255, 0.2);
        flex-shrink: 0;
    }

    .badge-dept {
        background: rgba(148, 163, 184, 0.12);
        color: #94a3b8;
        border: 1px solid rgba(148, 163, 184, 0.25);
    }

    .badge-active {
        background: rgba(34, 197, 94, 0.16);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.35);
    }

    .badge-inactive {
        background: rgba(148, 163, 184, 0.14);
        color: #94a3b8;
        border: 1px solid rgba(148, 163, 184, 0.25);
    }

    /* Responsive Views */
    @@media (max-width: 767.98px) {
        .page-container {
            padding-left: 12px !important;
            padding-right: 12px !important;
        }

        .header-actions {
            flex-direction: column;
            align-items: stretch !important;
            gap: 12px;
        }

        .desktop-table-view {
            display: none !important;
        }

        .mobile-cards-view {
            display: flex !important;
            flex-direction: column;
            gap: 12px;
        }

        .mobile-emp-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 14px;
        }
    }

    @@media (min-width: 768px) {
        .mobile-cards-view {
            display: none !important;
        }
    }
</style>

<div class="container-fluid py-4 px-3 px-md-4 page-container">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-md-center header-actions mb-4">
        <div>
            <h4 class="fw-bold text-white mb-1">Employee Directory</h4>
            <div class="small text-muted">Manage registered staff records and biometric enrollments</div>
        </div>
        <a asp-controller="Employee" asp-action="Create" class="btn btn-glow-primary d-flex align-items-center justify-content-center gap-2 py-2 px-3">
            <i class="bi bi-person-plus-fill"></i> Add Employee
        </a>
    </div>

    <!-- Responsive Filter Bar -->
    <div class="glass-panel p-3 p-md-4 mb-4">
        <form method="get" class="row g-2 g-md-3 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label small fw-semibold text-light mb-1">Search Directory</label>
                <div class="position-relative">
                    <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control glass-input" placeholder="Search by name, email or ID..." />
                </div>
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold text-light mb-1">Department</label>
                <select name="department" class="form-select glass-input">
                    <option value="">All Departments</option>
                    <option value="IT" selected="@(ViewBag.SelectedDepartment == "IT")">IT</option>
                    <option value="HR" selected="@(ViewBag.SelectedDepartment == "HR")">HR</option>
                    <option value="Finance" selected="@(ViewBag.SelectedDepartment == "Finance")">Finance</option>
                    <option value="Marketing" selected="@(ViewBag.SelectedDepartment == "Marketing")">Marketing</option>
                    <option value="Operations" selected="@(ViewBag.SelectedDepartment == "Operations")">Operations</option>
                </select>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2 mt-3 mt-md-0">
                <button type="submit" class="btn btn-glow-primary flex-fill py-2">
                    <i class="bi bi-search me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-glass-secondary px-3 py-2">
                    Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Main List / Table -->
    <div class="glass-panel overflow-hidden p-2 p-md-0">
        <!-- Desktop / Tablet Table View (>= 768px) -->
        <div class="table-responsive desktop-table-view">
            <table class="table table-glass align-middle">
                <thead>
                    <tr class="text-uppercase">
                        <th class="ps-4">Employee</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Joining Date</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var emp in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(emp.PhotoPath))
                                        {
                                            <img src="@emp.PhotoPath" class="avatar-img" alt="Photo" />
                                        }
                                        else
                                        {
                                            <div class="avatar-bubble">
                                                @(string.IsNullOrEmpty(emp.FullName) ? "E" : emp.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-semibold text-white">@emp.FullName</div>
                                            <div class="text-muted small">@emp.EmployeeCode &bull; @emp.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge badge-dept px-2 py-1">@emp.Department</span>
                                </td>
                                <td class="text-light small">@emp.Designation</td>
                                <td class="text-muted small">@emp.JoiningDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (emp.IsActive)
                                    {
                                        <span class="badge badge-active px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive px-2 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-controller="LiveAttendance" asp-action="Index" class="btn btn-sm btn-glass-secondary px-2 py-1" title="Gate Camera Test">
                                        <i class="bi bi-camera-video"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-person-slash fs-1 d-block mb-2 text-muted"></i>
                                <span class="text-muted">No registered employees found.</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Cards View (< 768px) -->
        <div class="mobile-cards-view">
            @if (Model != null && Model.Any())
            {
                foreach (var emp in Model)
                {
                    <div class="mobile-emp-card">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(emp.PhotoPath))
                                {
                                    <img src="@emp.PhotoPath" class="avatar-img" alt="Photo" />
                                }
                                else
                                {
                                    <div class="avatar-bubble">
                                        @(string.IsNullOrEmpty(emp.FullName) ? "E" : emp.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <div>
                                    <div class="fw-semibold text-white">@emp.FullName</div>
                                    <div class="text-muted small">@emp.EmployeeCode</div>
                                </div>
                            </div>
                            <div>
                                @if (emp.IsActive)
                                {
                                    <span class="badge badge-active px-2 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-inactive px-2 py-1">Inactive</span>
                                }
                            </div>
                        </div>

                        <div class="row g-2 pt-2 border-top border-secondary border-opacity-25 small">
                            <div class="col-6">
                                <span class="text-muted d-block">Department</span>
                                <span class="badge badge-dept">@emp.Department</span>
                            </div>
                            <div class="col-6 text-end">
                                <span class="text-muted d-block">Designation</span>
                                <span class="text-light">@emp.Designation</span>
                            </div>
                            <div class="col-8">
                                <span class="text-muted d-block">Email</span>
                                <span class="text-light text-truncate d-block">@emp.Email</span>
                            </div>
                            <div class="col-4 text-end d-flex align-items-end justify-content-end">
                                <a asp-controller="LiveAttendance" asp-action="Index" class="btn btn-sm btn-glass-secondary px-3 py-1" title="Gate Camera Test">
                                    <i class="bi bi-camera-video me-1"></i> Gate
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-slash fs-1 d-block mb-2 text-muted"></i>
                    <span class="text-muted">No registered employees found.</span>
                </div>
            }
        </div>
    </div>
</div>