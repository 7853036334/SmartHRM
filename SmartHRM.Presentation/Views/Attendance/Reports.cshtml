@model IEnumerable<SmartHRM.DataAccess.Entities.AttendanceLog>

@{
    ViewData["Title"] = "Attendance Reports";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<style>

 

    .attendance-page {
        min-height: 100vh;
        padding: 25px 30px;
    }




    .glass-panel {
        background: rgba(15, 23, 42, 0.72);

        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);

        border: 1px solid rgba(255, 255, 255, 0.10);

        border-radius: 20px;

        box-shadow:
            0 20px 45px -12px rgba(0, 0, 0, 0.55);
    }



    .page-title {
        color: #ffffff;
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .page-subtitle {
        color: #94a3b8;
        font-size: 13px;
    }


   

    .glass-input {
        background: rgba(255, 255, 255, 0.06) !important;

        border: 1px solid rgba(255, 255, 255, 0.14) !important;

        color: #f1f5f9 !important;

        border-radius: 10px !important;

        font-size: 0.9rem;

        transition: all 0.2s ease;
    }

    .glass-input:focus {
        background: rgba(255, 255, 255, 0.12) !important;

        border-color: #3b82f6 !important;

        box-shadow:
            0 0 0 3px rgba(59, 130, 246, 0.25) !important;

        color: #ffffff !important;
    }

    .glass-input option {
        background: #0f172a;
        color: #f8fafc;
    }


  

    .filter-label {
        color: #cbd5e1;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 6px;
    }




    .btn-glow-primary {
        background:
            linear-gradient(
                135deg,
                #2563eb 0%,
                #1d4ed8 100%
            );

        border: none;

        color: #ffffff;

        font-weight: 600;

        border-radius: 10px;

        transition: all 0.25s ease;

        box-shadow:
            0 8px 18px -4px
            rgba(37, 99, 235, 0.45);

        white-space: nowrap;
    }

    .btn-glow-primary:hover {
        background:
            linear-gradient(
                135deg,
                #1d4ed8 0%,
                #1e40af 100%
            );

        box-shadow:
            0 12px 22px -4px
            rgba(37, 99, 235, 0.65);

        color: #ffffff;

        transform: translateY(-1px);
    }



    .btn-glass-secondary {
        background: rgba(255, 255, 255, 0.07);

        border: 1px solid rgba(255, 255, 255, 0.16);

        color: #93c5fd;

        border-radius: 10px;

        font-weight: 500;

        transition: all 0.2s ease;

        white-space: nowrap;
    }

    .btn-glass-secondary:hover {
        background: rgba(255, 255, 255, 0.14);

        color: #ffffff;

        border-color:
            rgba(255, 255, 255, 0.30);
    }



    .report-heading {
        padding: 18px 20px;

        background:
            rgba(255, 255, 255, 0.035);

        border-bottom:
            1px solid rgba(255, 255, 255, 0.10);
    }

    .report-heading-title {
        color: #ffffff;

        font-size: 15px;

        font-weight: 600;

        margin: 0;
    }

    .report-count {
        color: #64748b;
        font-size: 12px;
    }


  

    .attendance-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .attendance-table {
        width: 100%;

        min-width: 1000px;

        margin: 0;

        border-collapse: collapse;

        color: #cbd5e1;
    }


    /* TABLE HEADER */

    .attendance-table thead {
        background:
            rgba(255, 255, 255, 0.04);
    }

    .attendance-table thead th {
        padding: 15px 16px;

        color: #94a3b8;

        font-size: 11px;

        font-weight: 600;

        letter-spacing: 0.06em;

        text-transform: uppercase;

        border-bottom:
            1px solid rgba(255, 255, 255, 0.10);

        white-space: nowrap;
    }



    .attendance-table tbody tr {
        background:
            rgba(15, 23, 42, 0.40);

        transition:
            background-color 0.2s ease;
    }

    .attendance-table tbody tr:hover {
        background:
            rgba(255, 255, 255, 0.045);
    }

    .attendance-table tbody tr:last-child td {
        border-bottom: none;
    }

    .attendance-table tbody td {
        padding: 14px 16px;

        color: #cbd5e1;

        font-size: 13px;

        vertical-align: middle;

        border-bottom:
            1px solid rgba(255, 255, 255, 0.05);

        white-space: nowrap;
    }


  

    .employee-name {
        color: #ffffff;

        font-size: 14px;

        font-weight: 600;
    }

    .employee-code {
        color: #64748b;

        font-size: 11px;

        margin-top: 3px;
    }


    /* =========================================================
       DEPARTMENT
       ========================================================= */

    .badge-dept {
        display: inline-flex;

        align-items: center;

        padding: 5px 10px;

        background:
            rgba(148, 163, 184, 0.12);

        border:
            1px solid rgba(148, 163, 184, 0.25);

        border-radius: 20px;

        color: #94a3b8;

        font-size: 11px;

        font-weight: 600;
    }


  

    .status-badge {
        display: inline-flex;

        align-items: center;

        gap: 5px;

        padding: 5px 10px;

        border-radius: 20px;

        font-size: 11px;

        font-weight: 600;
    }


    /* PRESENT */

    .badge-present {
        background:
            rgba(34, 197, 94, 0.16);

        color: #4ade80;

        border:
            1px solid rgba(34, 197, 94, 0.35);
    }


    /* LATE */

    .badge-late {
        background:
            rgba(234, 179, 8, 0.16);

        color: #facc15;

        border:
            1px solid rgba(234, 179, 8, 0.35);
    }


    /* ABSENT */

    .badge-absent {
        background:
            rgba(239, 68, 68, 0.16);

        color: #f87171;

        border:
            1px solid rgba(239, 68, 68, 0.35);
    }


 

    .time-in {
        color: #38bdf8;

        font-size: 12px;

        font-weight: 600;
    }

    .time-out {
        color: #cbd5e1;

        font-size: 12px;
    }

    .working-hours {
        color: #e2e8f0;

        font-size: 12px;

        font-weight: 600;
    }


  

    .mobile-cards-view {
        display: none;
    }

    .mobile-card-row {
        background:
            rgba(255, 255, 255, 0.04);

        border:
            1px solid rgba(255, 255, 255, 0.08);

        border-radius: 14px;

        padding: 15px;

        transition: all 0.2s ease;
    }

    .mobile-card-row:hover {
        background:
            rgba(255, 255, 255, 0.07);
    }


 

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-state-icon {
        color: #475569;

        font-size: 42px;

        margin-bottom: 12px;
    }

    .empty-state-title {
        color: #cbd5e1;

        font-size: 15px;

        font-weight: 600;

        margin-bottom: 5px;
    }

    .empty-state-text {
        color: #64748b;

        font-size: 12px;
    }


  

    @@media (max-width: 991.98px) {

        .attendance-page {
            padding: 20px;
        }

        .attendance-table {
            min-width: 1000px;
        }
    }


    @@media (max-width: 767.98px) {

        .attendance-page {
            padding: 15px 10px;
        }

        .page-title {
            font-size: 21px;
        }

        .page-subtitle {
            font-size: 12px;
        }

        .header-actions {
            flex-direction: column;

            align-items: stretch !important;

            gap: 15px;
        }

        .live-gate-button {
            width: 100%;
        }

        .desktop-table-view {
            display: none !important;
        }

        .mobile-cards-view {
            display: flex !important;

            flex-direction: column;

            gap: 12px;

            padding: 10px;
        }
    }


    @@media (max-width: 575.98px) {

        .attendance-page {
            padding: 12px 8px;
        }

        .glass-panel {
            border-radius: 15px;
        }

        .filter-panel {
            padding: 14px !important;
        }

        .mobile-card-row {
            padding: 13px;
        }
    }

</style>


<div class="attendance-page">


    

    <div class="header-actions d-flex justify-content-between align-items-center mb-4">

        <div>

            <h4 class="page-title">
                Attendance Reports
            </h4>

            <div class="page-subtitle">
                Filter historical attendance and manage biometric attendance logs
            </div>

        </div>


        <a asp-controller="LiveAttendance"
           asp-action="Index"
           class="btn btn-glass-secondary live-gate-button d-flex align-items-center justify-content-center gap-2 py-2 px-3">

            <i class="bi bi-camera-video"></i>

            Live Attendance Gate

        </a>

    </div>


 

    <div class="glass-panel filter-panel p-3 p-md-4 mb-4">

        <div class="mb-3">

            <div class="fw-semibold text-white">

                <i class="bi bi-funnel-fill me-2 text-primary"></i>

                Attendance Filters

            </div>

            <div class="small text-muted mt-1">
                Select a date range and attendance criteria
            </div>

        </div>


        <form method="get"
              asp-action="Reports">

            <div class="row g-3 align-items-end">


                <!-- START DATE -->

                <div class="col-12 col-sm-6 col-lg-3">

                    <label class="filter-label">
                        Start Date
                    </label>

                    <input type="date"
                           name="startDate"
                           value="@ViewBag.StartDate"
                           class="form-control glass-input" />

                </div>


          

                <div class="col-12 col-sm-6 col-lg-3">

                    <label class="filter-label">
                        End Date
                    </label>

                    <input type="date"
                           name="endDate"
                           value="@ViewBag.EndDate"
                           class="form-control glass-input" />

                </div>


 

                <div class="col-12 col-sm-6 col-lg-2">

                    <label class="filter-label">
                        Department
                    </label>

                    <select name="department"
                            class="form-select glass-input">

                        <option value="All"
                                selected="@(ViewBag.Department == "All")">
                            All Departments
                        </option>

                        <option value="IT"
                                selected="@(ViewBag.Department == "IT")">
                            IT
                        </option>

                        <option value="HR"
                                selected="@(ViewBag.Department == "HR")">
                            HR
                        </option>

                        <option value="Finance"
                                selected="@(ViewBag.Department == "Finance")">
                            Finance
                        </option>

                        <option value="Operations"
                                selected="@(ViewBag.Department == "Operations")">
                            Operations
                        </option>

                    </select>

                </div>


         

                <div class="col-12 col-sm-6 col-lg-2">

                    <label class="filter-label">
                        Status
                    </label>

                    <select name="status"
                            class="form-select glass-input">

                        <option value="All"
                                selected="@(ViewBag.Status == "All")">
                            All Status
                        </option>

                        <option value="Present"
                                selected="@(ViewBag.Status == "Present")">
                            Present
                        </option>

                        <option value="Late"
                                selected="@(ViewBag.Status == "Late")">
                            Late
                        </option>

                        <option value="Absent"
                                selected="@(ViewBag.Status == "Absent")">
                            Absent
                        </option>

                    </select>

                </div>


                <!-- FILTER BUTTON -->

                <div class="col-12 col-lg-2">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-glow-primary flex-fill py-2">

                            <i class="bi bi-search me-1"></i>

                            Filter

                        </button>


                        <a asp-action="Reports"
                           class="btn btn-glass-secondary px-3 py-2">

                            <i class="bi bi-arrow-clockwise"></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- EXPORT -->

            <div class="mt-3 pt-3 border-top border-secondary border-opacity-25">

                <div class="d-flex justify-content-end">

                    <a asp-action="ExportToExcel"
                       asp-route-startDate="@ViewBag.StartDate"
                       asp-route-endDate="@ViewBag.EndDate"
                       asp-route-department="@ViewBag.Department"
                       asp-route-status="@ViewBag.Status"
                       class="btn btn-glass-secondary d-flex align-items-center justify-content-center gap-2 px-3 py-2">

                        <i class="bi bi-file-earmark-excel text-success"></i>

                        Export Excel

                    </a>

                </div>

            </div>

        </form>

    </div>



    <div class="glass-panel overflow-hidden">


        <!-- TABLE HEADER -->

        <div class="report-heading d-flex justify-content-between align-items-center">

            <h5 class="report-heading-title">

                <i class="bi bi-calendar-check me-2 text-primary"></i>

                Attendance Records

            </h5>


            <span class="report-count">

                @if (Model != null)
                {
                    @Model.Count() <text> Records</text>
                }

            </span>

        </div>



        <div class="attendance-table-wrapper desktop-table-view">

            <table class="attendance-table">

                <thead>

                    <tr>

                        <th class="ps-4">
                            Employee
                        </th>

                        <th>
                            Department
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Time In
                        </th>

                        <th>
                            Time Out
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="pe-4 text-end">
                            Working Hours
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {

                        foreach (var row in Model)
                        {

                            <tr>

                               

                                <td class="ps-4">

                                    <div class="employee-name">

                                        @(row.Employee?.FullName ?? "Unknown")

                                    </div>

                                    <div class="employee-code">

                                        @(row.Employee?.EmployeeCode ?? "--")

                                    </div>

                                </td>


                                

                                <td>

                                    <span class="badge-dept">

                                        @(row.Employee?.Department ?? "General")

                                    </span>

                                </td>


                          

                                <td>

                                    <span class="text-light small">

                                        @row.Date.ToString("MMM dd, yyyy")

                                    </span>

                                </td>


                              

                                <td>

                                    <span class="time-in">

                                        @(row.TimeIn.HasValue
                                            ? DateTime.Today
                                                .Add(row.TimeIn.Value)
                                                .ToString("hh:mm tt")
                                            : "--:--")

                                    </span>

                                </td>


                              

                                <td>

                                    <span class="time-out">

                                        @(row.TimeOut.HasValue
                                            ? DateTime.Today
                                                .Add(row.TimeOut.Value)
                                                .ToString("hh:mm tt")
                                            : "--:--")

                                    </span>

                                </td>


                           

                                <td>

                                    @if (row.Status == "Present")
                                    {

                                        <span class="status-badge badge-present">

                                            <i class="bi bi-check-circle"></i>

                                            Present

                                        </span>

                                    }
                                    else if (row.Status == "Late")
                                    {

                                        <span class="status-badge badge-late">

                                            <i class="bi bi-clock"></i>

                                            Late

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="status-badge badge-absent">

                                            <i class="bi bi-x-circle"></i>

                                            @(row.Status ?? "Absent")

                                        </span>

                                    }

                                </td>


                               

                                <td class="pe-4 text-end">

                                    <span class="working-hours">

                                        @(row.WorkingHours?.ToString(@"hh\:mm") ?? "--:--")

                                    </span>

                                </td>

                            </tr>

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="7">

                                <div class="empty-state">

                                    <i class="bi bi-calendar-x empty-state-icon"></i>

                                    <div class="empty-state-title">
                                        No Attendance Records Found
                                    </div>

                                    <div class="empty-state-text">
                                        No attendance records were found for the selected filters.
                                    </div>

                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>



        <div class="mobile-cards-view">

            @if (Model != null && Model.Any())
            {

                foreach (var row in Model)
                {

                    <div class="mobile-card-row">


                        <!-- CARD HEADER -->

                        <div class="d-flex justify-content-between align-items-start mb-3">

                            <div>

                                <div class="employee-name">

                                    @(row.Employee?.FullName ?? "Unknown")

                                </div>

                                <div class="employee-code">

                                    @(row.Employee?.EmployeeCode ?? "--")

                                    <span class="mx-1">
                                        •
                                    </span>

                                    @(row.Employee?.Department ?? "General")

                                </div>

                            </div>


                            <!-- STATUS -->

                            <div>

                                @if (row.Status == "Present")
                                {

                                    <span class="status-badge badge-present">

                                        <i class="bi bi-check-circle"></i>

                                        Present

                                    </span>

                                }
                                else if (row.Status == "Late")
                                {

                                    <span class="status-badge badge-late">

                                        <i class="bi bi-clock"></i>

                                        Late

                                    </span>

                                }
                                else
                                {

                                    <span class="status-badge badge-absent">

                                        <i class="bi bi-x-circle"></i>

                                        @(row.Status ?? "Absent")

                                    </span>

                                }

                            </div>

                        </div>


                       

                        <div class="row g-3 pt-3 border-top border-secondary border-opacity-25">



                            <div class="col-6">

                                <span class="text-muted d-block small">
                                    Date
                                </span>

                                <span class="text-light small">

                                    @row.Date.ToString("MMM dd, yyyy")

                                </span>

                            </div>


                            

                            <div class="col-6 text-end">

                                <span class="text-muted d-block small">
                                    Working Hours
                                </span>

                                <span class="working-hours">

                                    @(row.WorkingHours?.ToString(@"hh\:mm") ?? "--:--")

                                </span>

                            </div>



                            <div class="col-6">

                                <span class="text-muted d-block small">
                                    Time In
                                </span>

                                <span class="time-in">

                                    @(row.TimeIn.HasValue
                                        ? DateTime.Today
                                            .Add(row.TimeIn.Value)
                                            .ToString("hh:mm tt")
                                        : "--:--")

                                </span>

                            </div>



                            <div class="col-6 text-end">

                                <span class="text-muted d-block small">
                                    Time Out
                                </span>

                                <span class="time-out">

                                    @(row.TimeOut.HasValue
                                        ? DateTime.Today
                                            .Add(row.TimeOut.Value)
                                            .ToString("hh:mm tt")
                                        : "--:--")

                                </span>

                            </div>

                        </div>

                    </div>

                }

            }
            else
            {

                <div class="empty-state">

                    <i class="bi bi-calendar-x empty-state-icon"></i>

                    <div class="empty-state-title">
                        No Attendance Records Found
                    </div>

                    <div class="empty-state-text">
                        No attendance records were found for the selected filters.
                    </div>

                </div>

            }

        </div>

    </div>

</div>