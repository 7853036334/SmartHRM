<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Ignore NU1510 pruning warning -->
		<NoWarn>$(NoWarn);NU1510</NoWarn>
	</PropertyGroup>
	<ItemGroup>
	  <Compile Remove="Controllers\EmployeeController.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Graph" Version="6.7.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SmartHRM.BusinessLogic\SmartHRM.BusinessLogic.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\videos\" />
	</ItemGroup>
</Project>